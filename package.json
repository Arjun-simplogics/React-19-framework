{
	"name": "react-framework",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@reduxjs/toolkit": "^2.6.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/jest": "^27.5.2",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"@types/react-redux": "^7.1.24",
		"antd": "^5.24.7",
		"axios": "^1.0.0",
		"dayjs": "1.11.7",
		"lodash": "^4.17.21",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-intersection-observer": "^9.5.3",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.5.1",
		"react-table-column-resizer": "1.3.2",
		"sass": "1.55.0",
		"typescript": "4.8.4",
		"web-vitals": "2.1.4"
	},
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"test": "vite test",
		"eject": "vite eject",
		"analyze": "source-map-explorer 'build/static/js/*.js'",
		"pretty:fix": "prettier --config ./.prettierrc --write \"src/**/*.{ts, tsx, scss}\"",
		"pretty:check": "prettier --config ./.prettierrc --check \"src/**/*.{ts, tsx, scss}\"",
		"lint:check": "eslint -c ./.eslintrc.json src/**",
		"lint:fix": "eslint --fix -c ./.eslintrc.json src/**",
		"serve": "vite preview"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@types/lodash": "4.14.191",
		"@types/node": "^22.14.1",
		"@typescript-eslint/eslint-plugin": "5.39.0",
		"@typescript-eslint/parser": "5.39.0",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "8.24.0",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-prettier": "^5.2.6",
		"eslint-plugin-react": "7.31.8",
		"husky": "8.0.1",
		"lint-staged": "13.0.3",
		"prettier": "^3.5.3",
		"source-map-explorer": "2.5.3",
		"vite": "^6.2.3",
		"vite-plugin-checker": "^0.9.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
			"prettier --write"
		],
		"src/**": [
			"eslint -c ./.eslintrc.json src/**"
		]
	}
}
